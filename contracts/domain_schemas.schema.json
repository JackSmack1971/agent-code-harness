        "criterion_results": { "type": "array", "items": { "$ref": "semantic_types.schema.json#/$defs/CriterionReview" } },
        "overall_status": { "type": "string", "enum": ["PASS", "FAIL", "INCONCLUSIVE"] },
        "artifact_ids": { "type": "array", "items": { "$ref": "semantic_types.schema.json#/$defs/ArtifactId" } },
