        "revoked_at": { "anyOf": [{ "$ref": "semantic_types.schema.json#/$defs/UtcTimestamp" }, { "type": "null" }] },
        "consumption_limit": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
        "consumed_count": { "type": "integer", "minimum": 0 }
      }
    },

    "IntentReviewResult": {
      "type": "object",
      "description": "9.6.3, 10.15.6.",
      "additionalProperties": false,
      "required": [
        "schema_name", "schema_version", "run_id", "candidate_snapshot", "reviewer_route",
        "reviewer_model_identity", "independence_context_digest", "criterion_results",
        "overall_status", "artifact_ids", "created_at", "digest"
