# Codex execpolicy rules for commands that request execution outside the sandbox.
# These rules do not grant authority by themselves; sandbox/approval policy remains authoritative.

prefix_rule(
    pattern = ["sudo"],
    decision = "forbidden",
    justification = "Privilege escalation is outside this project control plane.",
    match = ["sudo true", "sudo apt update"],
)

prefix_rule(
    pattern = ["git", "push", "--force"],
    decision = "forbidden",
    justification = "Force-push can rewrite shared history and is prohibited by project policy.",
    match = ["git push --force", "git push --force origin main"],
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Hard reset can discard unrelated work and must be handled explicitly outside agent automation.",
    match = ["git reset --hard", "git reset --hard HEAD~1"],
)

prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "Remote publication is a separate source-control authority boundary.",
    match = ["git push", "git push origin feature", "git push --force"],
)
