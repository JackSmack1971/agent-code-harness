        "completed_at": { "anyOf": [{ "$ref": "semantic_types.schema.json#/$defs/UtcTimestamp" }, { "type": "null" }] },
        "digest": { "$ref": "semantic_types.schema.json#/$defs/Digest" }
      }
    },

    "QualifiedDefault": {
