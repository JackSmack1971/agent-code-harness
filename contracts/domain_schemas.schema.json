        "result_kind": { "anyOf": [{ "type": "string", "enum": ["COMMIT", "PATCH_ARTIFACT"] }, { "type": "null" }] },
        "result_commit": { "anyOf": [{ "$ref": "semantic_types.schema.json#/$defs/GitOid" }, { "type": "null" }] },
        "result_patch_artifact_id": { "anyOf": [{ "$ref": "semantic_types.schema.json#/$defs/ArtifactId" }, { "type": "null" }] },
        "evidence_artifact_ids": { "type": "array", "items": { "$ref": "semantic_types.schema.json#/$defs/ArtifactId" } },
        "integrated": { "type": "boolean", "description": "Whether the parent has serially integrated this child's output." },
        "digest": { "$ref": "semantic_types.schema.json#/$defs/Digest" }
      }
    },

    "AcceptanceRequest": {
      "type": "object",
