{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-coding-harness.dev/contracts/meta/schema_digest_exclusions.schema.json",
  "x-contract-name": "SchemaDigestExclusions",
  "x-contract-version": 1,
  "title": "Schema digest exclusions",
  "description": "Non-semantic JSON Schema keywords removed before a schema document is canonicalized and digested for schema identity (CanonicalSerialization v1, 10.2.2).",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "x-contract-name", "x-contract-version", "excluded_keywords"],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://agentic-coding-harness.dev/contracts/meta/schema_digest_exclusions.schema.json"
    },
    "x-contract-name": { "const": "SchemaDigestExclusions" },
    "x-contract-version": { "type": "integer", "minimum": 1 },
    "excluded_keywords": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
