        "digest": { "$ref": "semantic_types.schema.json#/$defs/Digest" }
      }
    },

    "RunRecord": {
      "type": "object",
      "description": "9.6.4, 9.11.2 runs table. Ordinary durable record; digest added per the global identity rule (9.6.1) beyond the pre-Closure DDL sketch.",
