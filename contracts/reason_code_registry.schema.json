{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-coding-harness.dev/contracts/reason_code_registry.schema.json",
  "x-contract-name": "ReasonCodeRegistry",
  "x-contract-version": 1,
  "title": "ReasonCodeRegistry v1",
  "description": "Sole registry for machine-stable reason codes (Unified Implementation Blueprint 10.5). Codes are append-only within a major contract version.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "x-contract-name", "x-contract-version", "namespaces", "codes"],
  "properties": {
    "$schema": { "const": "https://agentic-coding-harness.dev/contracts/reason_code_registry.schema.json" },
    "x-contract-name": { "const": "ReasonCodeRegistry" },
    "x-contract-version": { "type": "integer", "minimum": 1 },
    "namespaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z][A-Z]*_$" }
    },
    "codes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/code" }
    }
  },
  "$defs": {
    "code": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "namespace", "description", "minimum_required"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$" },
        "namespace": { "type": "string", "pattern": "^[A-Z][A-Z]*_$" },
        "description": { "type": "string", "minLength": 1 },
        "minimum_required": {
          "type": "boolean",
          "description": "true only for a code appearing in Blueprint 10.5's minimum-required-codes list."
        }
      }
    }
  }
}
