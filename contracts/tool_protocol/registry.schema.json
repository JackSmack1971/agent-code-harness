{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-coding-harness.dev/contracts/tool_protocol/registry.schema.json",
  "x-contract-name": "ToolProtocol",
  "x-contract-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "x-contract-name", "x-contract-version", "tools"],
  "properties": {
    "$schema": {"const": "https://agentic-coding-harness.dev/contracts/tool_protocol/registry.schema.json"},
    "x-contract-name": {"const": "ToolProtocol"},
    "x-contract-version": {"const": 1},
    "tools": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/tool"}}
  },
  "$defs": {
    "tool": {
      "type": "object", "additionalProperties": false,
      "required": ["tool_name", "tool_version", "request_schema_ref", "result_schema_ref", "error_codes", "effect_calculator", "resource_calculator", "atomicity", "cancellation_profile", "output_limit_profile"],
      "properties": {
        "tool_name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"},
        "tool_version": {"const": 1},
        "request_schema_ref": {"type": "string", "minLength": 1},
        "result_schema_ref": {"type": "string", "minLength": 1},
        "error_codes": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"}},
        "effect_calculator": {"const": "calculate_effects"},
        "resource_calculator": {"const": "calculate_resources"},
        "atomicity": {"enum": ["READ_ONLY", "SINGLE_RESOURCE_ATOMIC", "JOURNALED_MULTI_RESOURCE"]},
        "cancellation_profile": {"type": "string", "minLength": 1},
        "output_limit_profile": {"type": "string", "minLength": 1}
      }
    }
  }
}
