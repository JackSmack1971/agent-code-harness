    "ArtifactRecord": {
      "type": "object",
      "description": "9.6.4, 9.11.2 artifacts table, 9.11.5, 10.13.4. artifact_id is the harness-owned UUIDv7 per 10.3.2 (superseding the pre-Closure artifacts(artifact_digest PK) sketch, same resolution semantic_types.schema.json already documents for ArtifactId); content_digest is the separate content-addressing digest of the raw stored bytes.",
      "additionalProperties": false,
      "required": [
        "schema_name", "schema_version", "artifact_id", "content_digest", "media_type",
        "byte_length", "storage_relpath", "classification", "created_at", "digest"
      ],
      "properties": {
        "schema_name": { "const": "ArtifactRecord" },
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
