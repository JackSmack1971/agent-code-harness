        "child_worktree_identity": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["DISPATCHED", "COMPLETED", "FAILED", "CANCELLED"] },
        "dispatched_at": { "$ref": "semantic_types.schema.json#/$defs/UtcTimestamp" },
