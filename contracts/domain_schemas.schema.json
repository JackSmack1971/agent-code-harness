{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-coding-harness.dev/contracts/domain_schemas.schema.json",
  "x-contract-name": "DomainSchemas",
  "x-contract-version": 1,
  "$comment": "Extension point: this document is a $defs library, not an instance-validating document in its own right, mirroring semantic_types.schema.json's own documented extension point. Blueprint 9.6/10.3/10.15. Every identity-bearing object here carries schema_name/schema_version (9.6.1) and, except ApprovalGrant (whose blueprint field list at 9.6.3 explicitly omits one), a digest computed from CanonicalSerialization v1 over the object's fields excluding the digest field itself. Ordinary durable records (9.6.4) are given a digest for the same tamper-evidence/identity reasons even though the pre-Closure persistence DDL sketch in 9.11.2 does not spell out every field; those extensions are documented per-type below. Identifier types not enumerated in Blueprint 10.3.2's registry (AcceptanceRequestId, QualifiedDefaultId) are declared locally here as UUIDv7Id aliases rather than added to semantic_types.schema.json, keeping SemanticTypes v1 unmodified.",
  "title": "DomainSchemas v1",
  "description": "Strict, versioned, unknown-field-rejecting durable schemas for every Phase-0/Phase-1 authoritative record (Unified Implementation Blueprint 9.6, 10.3, 10.15).",
  "type": "object",
  "additionalProperties": false,
  "properties": {},
  "x-registered-schemas": [
    "GoalContract",
    "ChangeContract",
    "VerificationPlan",
    "RepositorySnapshot",
    "CandidateSnapshot",
    "VerificationResult",
    "EvidenceManifest",
    "ApprovalRequest",
    "ApprovalGrant",
    "IntentReviewResult",
    "RunRecord",
    "CheckpointRecord",
    "ArtifactRecord",
    "ToolCallRecord",
    "ModelCallRecord",
    "SubagentExecutionRecord",
    "AcceptanceRequest",
    "IntegrationRecord",
    "QualifiedDefault"
  ],
  "$defs": {
    "SchemaVersion": { "$ref": "semantic_types.schema.json#/$defs/SchemaVersion" },

    "State": {
      "type": "string",
      "description": "3.4. Canonical v1 runtime state registry. No aliases accepted in persisted state.",
      "enum": [
        "CREATED", "REPOSITORY_READY", "GOAL_BOUND", "RECONNAISSANCE", "PLAN_READY",
        "IMPLEMENTING", "VERIFYING_FOCUSED", "VERIFYING_BROAD", "INTENT_REVIEW",
        "READY_FOR_USER", "ACCEPTING", "ACCEPTED", "REJECTED", "BLOCKED",
        "INTEGRATION_CONFLICT", "RECOVERY_REQUIRED", "RECONCILIATION_REQUIRED",
        "FAILED", "INTERRUPTED"
      ]
    },

    "AcceptanceRequestId": { "$ref": "semantic_types.schema.json#/$defs/UUIDv7Id", "description": "Local extension: not enumerated in Blueprint 10.3.2's identifier registry; minted the same way as every other UUIDv7Id so AcceptanceRequest (named in 9.6.4) has a stable identity." },
    "QualifiedDefaultId": { "$ref": "semantic_types.schema.json#/$defs/UUIDv7Id", "description": "Local extension, same rationale as AcceptanceRequestId; backs the append-only QualifiedDefault chain (4.7)." },

    "AcceptanceCriterionRef": {
      "type": "object",
      "description": "9.6.3 ChangeContract.acceptance_criteria element: a stable reference into a specific Goal revision's AcceptanceCriterion list.",
      "additionalProperties": false,
      "required": ["criterion_id", "goal_revision_id"],
      "properties": {
        "criterion_id": { "type": "string", "minLength": 1 },
        "goal_revision_id": { "$ref": "semantic_types.schema.json#/$defs/GoalRevisionId" }
      }
    },

    "NormalizedResource": {
      "type": "object",
      "$comment": "Owned by ResourceNormalization v1 (Blueprint 10.10, Phase 2 deliverable, not yet materialized under contracts/). Structural carrier only, mirroring the ResourcePattern carrier already documented in semantic_types.schema.json. Do not add kind-specific normalized-value shapes here.",
      "additionalProperties": false,
      "required": ["kind", "normalized_key", "value"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "normalized_key": { "type": "string", "minLength": 1, "description": "Canonical string form used for authorization equality comparisons." },
        "value": { "type": "object" }
      }
    },

    "ToolError": {
      "type": "object",
      "description": "9.14.3.",
      "additionalProperties": false,
      "required": ["code", "category", "message", "retryable", "details"],
      "properties": {
        "code": { "$ref": "semantic_types.schema.json#/$defs/ReasonCode" },
        "category": {
          "type": "string",
          "enum": ["VALIDATION", "POLICY", "ENVIRONMENT", "PROCESS", "FILESYSTEM", "GIT", "NETWORK", "PROVIDER", "INTERNAL"]
        },
        "message": { "type": "string", "minLength": 1, "description": "Human-readable, redacted." },
        "retryable": { "type": "boolean" },
        "details": {
          "type": "object",
          "$comment": "9.14.3 says 'strict redacted object' but does not enumerate its shape, and the redaction contract (9.10.3) is not yet materialized under contracts/. Documented extension point, same pattern as NormalizedResource.value/Effect/ResourcePattern: consumers MUST NOT widen this into an unredacted arbitrary payload once a RedactionContract exists."
        }
      }
    },

    "IntentReviewSpec": {
      "type": "object",
      "description": "9.6.3 VerificationPlan.intent_review. 10.15.6 reviewer independence requirements.",
      "additionalProperties": false,
      "required": ["reviewer_route", "criterion_refs", "required"],
      "properties": {
        "reviewer_route": { "type": "string", "minLength": 1 },
        "criterion_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "required": { "type": "boolean", "default": true }
      }
    },

    "IdentityDependency": {
      "type": "string",
      "description": "10.15.7. A result remains current only while all declared dependencies equal their bound values.",
      "enum": [
        "CANDIDATE_SNAPSHOT", "CONFIG_DIGEST", "POLICY_DIGEST", "TOOL_SCHEMA_DIGEST",
        "ENVIRONMENT_DIGEST", "PROVIDER_ROUTE_DIGEST", "DESTINATION_SNAPSHOT"
      ]
    },

    "BoundedStreamAssertion": {
      "type": "object",
      "description": "10.15.4. A bounded stdout/stderr assertion for CommandCheck; not an arbitrary object so a check mechanism cannot smuggle unconstrained data through the verification path.",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "type": "string", "enum": ["CONTAINS", "NOT_CONTAINS", "REGEX_MATCH", "MAX_LENGTH"] },
        "value": { "type": "string" }
      }
    },

    "CheckMechanism": {
      "description": "10.15.3. VerificationCheckSpec.mechanism is exactly one of these seven kinds. Supersedes 9.15.2's pre-Closure 'command_or_mechanism' field name per the Closure-amendments-over-body authority order.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "argv"],
          "properties": {
            "kind": { "const": "COMMAND" },
            "argv": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "expected_exit_codes": { "type": "array", "items": { "type": "integer" } },
            "stdout_assertions": { "type": "array", "items": { "$ref": "#/$defs/BoundedStreamAssertion" } },
            "stderr_assertions": { "type": "array", "items": { "$ref": "#/$defs/BoundedStreamAssertion" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "callable_ref"],
          "properties": {
            "kind": { "const": "PYTHON_CALLABLE" },
            "callable_ref": { "type": "string", "minLength": 1, "description": "10.15.4. Registered harness/repository-trusted code, never loaded from untrusted generated text." }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "json_pointer", "comparator", "expected"],
          "properties": {
            "kind": { "const": "JSON_ASSERTION" },
            "target_artifact_id": { "anyOf": [{ "$ref": "semantic_types.schema.json#/$defs/ArtifactId" }, { "type": "null" }] },
            "json_pointer": { "type": "string" },
            "comparator": { "type": "string", "enum": ["equals", "not_equals", "exists", "contains", "gt", "gte", "lt", "lte"] },
            "expected": {}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path", "assertion"],
          "properties": {
            "kind": { "const": "FILE_ASSERTION" },
            "path": { "$ref": "semantic_types.schema.json#/$defs/CanonicalPath" },
            "assertion": { "type": "string", "enum": ["EXISTS", "NOT_EXISTS", "CONTAINS", "DIGEST_EQUALS"] },
            "expected": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "invariant_id"],
          "properties": {
            "kind": { "const": "REPOSITORY_INVARIANT" },
            "invariant_id": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "baseline_artifact_id", "candidate_artifact_id", "comparator"],
          "properties": {
            "kind": { "const": "ARTIFACT_COMPARISON" },
            "baseline_artifact_id": { "$ref": "semantic_types.schema.json#/$defs/ArtifactId" },
            "candidate_artifact_id": { "$ref": "semantic_types.schema.json#/$defs/ArtifactId" },
            "comparator": { "type": "string", "enum": ["BYTE_EQUAL", "DIGEST_EQUAL"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "reviewer_route"],
          "properties": {
            "kind": { "const": "REVIEWER" },
            "reviewer_route": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },

    "SuccessPredicate": {
      "description": "9.15.2 success_predicate, restricted per 10.15.4: bounded exit-code sets, registered regex patterns, or a restricted JSON Pointer + comparator language. No arbitrary eval/shell predicate strings.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "exit_codes"],
          "properties": {
            "kind": { "const": "EXIT_CODE_SET" },
            "exit_codes": { "type": "array", "minItems": 1, "items": { "type": "integer" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "pattern", "target"],
          "properties": {
            "kind": { "const": "REGEX_MATCH" },
            "pattern": { "type": "string", "minLength": 1, "description": "Registered pattern; cannot execute code." },
            "target": { "type": "string", "enum": ["STDOUT", "STDERR"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "json_pointer", "comparator", "expected"],
          "properties": {
            "kind": { "const": "JSON_POINTER" },
            "json_pointer": { "type": "string" },
            "comparator": { "type": "string", "enum": ["equals", "not_equals", "exists", "contains", "gt", "gte", "lt", "lte"] },
            "expected": {}
          }
        }
      ]
    },

    "VerificationCheckSpec": {
      "type": "object",
      "description": "9.15.2, 10.15.3, 10.15.7. Nested value type embedded in VerificationPlan.checks / post_integration_checks; not independently registered as a top-level durable object.",
      "additionalProperties": false,
      "required": [
        "check_id", "name", "check_type", "required", "mechanism", "expected_effects",
        "resource_scope", "timeout_ms", "success_predicate", "feasibility_policy",
        "criterion_refs", "identity_dependencies"
      ],
      "properties": {
        "check_id": { "$ref": "semantic_types.schema.json#/$defs/CheckId" },
        "name": { "type": "string", "minLength": 1 },
        "check_type": { "type": "string", "enum": ["BASELINE", "FOCUSED", "BROAD", "STRUCTURAL", "INTENT", "POST_INTEGRATION"] },
        "required": { "type": "boolean" },
        "mechanism": { "$ref": "#/$defs/CheckMechanism" },
        "expected_effects": { "type": "array", "uniqueItems": true, "items": { "$ref": "semantic_types.schema.json#/$defs/Effect" } },
        "resource_scope": { "type": "array", "items": { "$ref": "semantic_types.schema.json#/$defs/ResourcePattern" } },
        "timeout_ms": { "type": "integer", "minimum": 0 },
        "success_predicate": { "$ref": "#/$defs/SuccessPredicate" },
        "feasibility_policy": { "type": "string", "enum": ["FAIL", "INCONCLUSIVE", "WAIVER_ALLOWED"] },
        "criterion_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "identity_dependencies": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/IdentityDependency" } }
      }
    },

    "GoalContract": {
      "type": "object",
      "description": "9.6.3. A material change to intent, desired_outcome, constraints, or acceptance_criteria creates a new goal_revision_id; it never mutates the prior revision in place (INV-REVISION-001).",
      "additionalProperties": false,
      "required": [
        "schema_name", "schema_version", "goal_id", "goal_revision_id", "parent_revision_id",
        "intent", "desired_outcome", "constraints", "acceptance_criteria", "uncertainties",
        "created_at", "source", "digest"
      ],
      "properties": {
        "schema_name": { "const": "GoalContract" },
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "goal_id": { "$ref": "semantic_types.schema.json#/$defs/GoalId" },
        "goal_revision_id": { "$ref": "semantic_types.schema.json#/$defs/GoalRevisionId" },
        "parent_revision_id": { "anyOf": [{ "$ref": "semantic_types.schema.json#/$defs/GoalRevisionId" }, { "type": "null" }] },
        "intent": { "$ref": "semantic_types.schema.json#/$defs/NonEmptyString" },
        "desired_outcome": { "$ref": "semantic_types.schema.json#/$defs/NonEmptyString" },
        "constraints": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "acceptance_criteria": { "type": "array", "items": { "$ref": "semantic_types.schema.json#/$defs/AcceptanceCriterion" } },
        "uncertainties": { "type": "array", "items": { "$ref": "semantic_types.schema.json#/$defs/Uncertainty" } },
        "created_at": { "$ref": "semantic_types.schema.json#/$defs/UtcTimestamp" },
        "source": { "type": "string", "enum": ["USER", "AUTHORIZED_CI"] },
        "digest": { "$ref": "semantic_types.schema.json#/$defs/Digest" }
      }
    },

    "ChangeContract": {
      "type": "object",
      "description": "9.6.3.",
      "additionalProperties": false,
      "required": [
        "schema_name", "schema_version", "change_id", "change_revision_id", "parent_revision_id",
        "goal_revision_id", "base_repository_snapshot", "summary", "allowed_resources",
        "required_effects", "acceptance_criteria", "verification_plan_id", "created_at", "digest"
      ],
      "properties": {
        "schema_name": { "const": "ChangeContract" },
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "change_id": { "$ref": "semantic_types.schema.json#/$defs/ChangeId" },
        "change_revision_id": { "$ref": "semantic_types.schema.json#/$defs/ChangeRevisionId" },
        "parent_revision_id": { "anyOf": [{ "$ref": "semantic_types.schema.json#/$defs/ChangeRevisionId" }, { "type": "null" }] },
        "goal_revision_id": { "$ref": "semantic_types.schema.json#/$defs/GoalRevisionId" },
        "base_repository_snapshot": { "$ref": "semantic_types.schema.json#/$defs/SnapshotDigest" },
        "summary": { "$ref": "semantic_types.schema.json#/$defs/NonEmptyString" },
        "allowed_resources": { "type": "array", "items": { "$ref": "semantic_types.schema.json#/$defs/ResourcePattern" } },
        "required_effects": { "type": "array", "uniqueItems": true, "items": { "$ref": "semantic_types.schema.json#/$defs/Effect" } },
        "acceptance_criteria": { "type": "array", "items": { "$ref": "#/$defs/AcceptanceCriterionRef" } },
        "verification_plan_id": { "$ref": "semantic_types.schema.json#/$defs/PlanId" },
        "created_at": { "$ref": "semantic_types.schema.json#/$defs/UtcTimestamp" },
        "digest": { "$ref": "semantic_types.schema.json#/$defs/Digest" }
      }
    },

    "VerificationPlan": {
      "type": "object",
      "description": "9.6.3. May be created before a candidate exists; individual results bind to an exact candidate snapshot.",
      "additionalProperties": false,
      "required": [
        "schema_name", "schema_version", "plan_id", "change_revision_id", "candidate_binding",
        "checks", "intent_review", "post_integration_checks", "created_at", "digest"
      ],
      "properties": {
        "schema_name": { "const": "VerificationPlan" },
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "plan_id": { "$ref": "semantic_types.schema.json#/$defs/PlanId" },
        "change_revision_id": { "$ref": "semantic_types.schema.json#/$defs/ChangeRevisionId" },
        "candidate_binding": { "const": "LATE_BOUND" },
        "checks": { "type": "array", "items": { "$ref": "#/$defs/VerificationCheckSpec" } },
        "intent_review": { "$ref": "#/$defs/IntentReviewSpec" },
        "post_integration_checks": { "type": "array", "items": { "$ref": "#/$defs/VerificationCheckSpec" } },
        "created_at": { "$ref": "semantic_types.schema.json#/$defs/UtcTimestamp" },
        "digest": { "$ref": "semantic_types.schema.json#/$defs/Digest" }
      }
    },

    "RepositorySnapshot": {
      "type": "object",
      "description": "9.6.3.",
      "additionalProperties": false,
      "required": [
        "schema_name", "schema_version", "repository_root_identity", "git_common_dir_identity",
        "head_commit", "head_ref", "index_digest", "tracked_worktree_digest",
        "untracked_manifest_digest", "submodule_manifest_digest", "is_dirty", "captured_at", "digest"
      ],
      "properties": {
        "schema_name": { "const": "RepositorySnapshot" },
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "repository_root_identity": { "type": "string", "minLength": 1 },
        "git_common_dir_identity": { "type": "string", "minLength": 1 },
        "head_commit": { "anyOf": [{ "$ref": "semantic_types.schema.json#/$defs/GitOid" }, { "type": "null" }] },
        "head_ref": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "index_digest": { "$ref": "semantic_types.schema.json#/$defs/Digest" },
        "tracked_worktree_digest": { "$ref": "semantic_types.schema.json#/$defs/Digest" },
        "untracked_manifest_digest": { "$ref": "semantic_types.schema.json#/$defs/Digest" },
        "submodule_manifest_digest": { "$ref": "semantic_types.schema.json#/$defs/Digest" },
        "is_dirty": { "type": "boolean" },
        "captured_at": { "$ref": "semantic_types.schema.json#/$defs/UtcTimestamp" },
        "digest": { "$ref": "semantic_types.schema.json#/$defs/SnapshotDigest" }
      }
    },

    "CandidateSnapshot": {
      "type": "object",
      "description": "9.6.3.",
      "additionalProperties": false,
      "required": [
        "schema_name", "schema_version", "run_id", "base_repository_snapshot", "worktree_identity",
        "head_commit", "tree_digest", "index_digest", "untracked_manifest_digest", "captured_at", "digest"
      ],
      "properties": {
        "schema_name": { "const": "CandidateSnapshot" },
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "run_id": { "$ref": "semantic_types.schema.json#/$defs/RunId" },
        "base_repository_snapshot": { "$ref": "semantic_types.schema.json#/$defs/SnapshotDigest" },
        "worktree_identity": { "type": "string", "minLength": 1 },
        "head_commit": { "anyOf": [{ "$ref": "semantic_types.schema.json#/$defs/GitOid" }, { "type": "null" }] },
        "tree_digest": { "$ref": "semantic_types.schema.json#/$defs/Digest" },
        "index_digest": { "$ref": "semantic_types.schema.json#/$defs/Digest" },
        "untracked_manifest_digest": { "$ref": "semantic_types.schema.json#/$defs/Digest" },
        "captured_at": { "$ref": "semantic_types.schema.json#/$defs/UtcTimestamp" },
        "digest": { "$ref": "semantic_types.schema.json#/$defs/SnapshotDigest" }
      }
    },

    "VerificationResult": {
      "type": "object",
      "description": "9.6.3. INV-IDENTITY-001/INV-VERIFY-002: candidate_snapshot MUST equal the exact CandidateSnapshot the evidence was produced against; a candidate mutation invalidates prior results.",
      "additionalProperties": false,
      "required": [
        "schema_name", "schema_version", "check_id", "plan_id", "candidate_snapshot", "check_type",
        "status", "started_at", "finished_at", "tool_call_ids", "artifact_ids", "claim_refs",
        "reason_code", "digest"
      ],
      "properties": {
        "schema_name": { "const": "VerificationResult" },
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "check_id": { "$ref": "semantic_types.schema.json#/$defs/CheckId" },
        "plan_id": { "$ref": "semantic_types.schema.json#/$defs/PlanId" },
        "candidate_snapshot": { "$ref": "semantic_types.schema.json#/$defs/SnapshotDigest" },
        "check_type": { "type": "string", "enum": ["BASELINE", "FOCUSED", "BROAD", "STRUCTURAL", "INTENT", "POST_INTEGRATION"] },
        "status": { "type": "string", "enum": ["PASS", "FAIL", "ERROR", "INCONCLUSIVE", "NOT_APPLICABLE"] },
        "started_at": { "$ref": "semantic_types.schema.json#/$defs/UtcTimestamp" },
        "finished_at": { "$ref": "semantic_types.schema.json#/$defs/UtcTimestamp" },
        "tool_call_ids": { "type": "array", "items": { "$ref": "semantic_types.schema.json#/$defs/ToolCallId" } },
        "artifact_ids": { "type": "array", "items": { "$ref": "semantic_types.schema.json#/$defs/ArtifactId" } },
        "claim_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "reason_code": { "anyOf": [{ "$ref": "semantic_types.schema.json#/$defs/ReasonCode" }, { "type": "null" }] },
        "digest": { "$ref": "semantic_types.schema.json#/$defs/Digest" }
      }
    },

    "EvidenceManifest": {
      "type": "object",
      "description": "9.6.3.",
      "additionalProperties": false,
      "required": [
        "schema_name", "schema_version", "run_id", "change_revision_id", "candidate_snapshot",
        "criterion_evidence", "verification_result_digests", "review_result_digest", "created_at", "digest"
      ],
      "properties": {
        "schema_name": { "const": "EvidenceManifest" },
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "run_id": { "$ref": "semantic_types.schema.json#/$defs/RunId" },
        "change_revision_id": { "$ref": "semantic_types.schema.json#/$defs/ChangeRevisionId" },
        "candidate_snapshot": { "$ref": "semantic_types.schema.json#/$defs/SnapshotDigest" },
        "criterion_evidence": { "type": "array", "items": { "$ref": "semantic_types.schema.json#/$defs/CriterionEvidence" } },
        "verification_result_digests": { "type": "array", "items": { "$ref": "semantic_types.schema.json#/$defs/Digest" } },
        "review_result_digest": { "anyOf": [{ "$ref": "semantic_types.schema.json#/$defs/Digest" }, { "type": "null" }] },
        "created_at": { "$ref": "semantic_types.schema.json#/$defs/UtcTimestamp" },
        "digest": { "$ref": "semantic_types.schema.json#/$defs/Digest" }
      }
    },

    "ApprovalRequest": {
      "type": "object",
      "description": "9.6.3.",
      "additionalProperties": false,
      "required": [
        "schema_name", "schema_version", "approval_id", "run_id", "tool_call_id", "effects",
        "resources", "argument_digest", "credential_exposure", "reversibility", "requested_scope",
        "created_at", "expires_at", "digest"
      ],
      "properties": {
        "schema_name": { "const": "ApprovalRequest" },
