      "additionalProperties": false,
      "required": [
        "schema_name", "schema_version", "approval_id", "request_digest", "disposition", "actor_type",
        "actor_id", "issued_at", "expires_at", "revoked_at", "consumption_limit", "consumed_count"
      ],
      "properties": {
        "schema_name": { "const": "ApprovalGrant" },
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
