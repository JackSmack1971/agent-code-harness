        "config_digest": { "anyOf": [{ "$ref": "semantic_types.schema.json#/$defs/ConfigDigest" }, { "type": "null" }] },
        "policy_digest": { "anyOf": [{ "$ref": "semantic_types.schema.json#/$defs/PolicyDigest" }, { "type": "null" }] },
        "resume_target_state": { "anyOf": [{ "$ref": "#/$defs/State" }, { "type": "null" }] },
        "created_at": { "$ref": "semantic_types.schema.json#/$defs/UtcTimestamp" },
        "updated_at": { "$ref": "semantic_types.schema.json#/$defs/UtcTimestamp" },
        "digest": { "$ref": "semantic_types.schema.json#/$defs/Digest" }
      }
    },

    "CheckpointRecord": {
      "type": "object",
      "description": "9.6.4, 9.8.5, 9.11.2 checkpoints table.",
