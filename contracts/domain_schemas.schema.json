        "content_digest": { "$ref": "semantic_types.schema.json#/$defs/Digest" },
        "media_type": { "type": "string", "minLength": 1 },
        "byte_length": { "type": "integer", "minimum": 0 },
        "storage_relpath": { "type": "string", "minLength": 1 },
        "classification": { "$ref": "semantic_types.schema.json#/$defs/DataClassification" },
        "created_at": { "$ref": "semantic_types.schema.json#/$defs/UtcTimestamp" },
        "digest": { "$ref": "semantic_types.schema.json#/$defs/Digest" }
      }
    },

    "ToolCallRecord": {
      "type": "object",
      "description": "9.6.4, 9.14.1 (request envelope), 9.14.2 (result envelope) combined into the persisted record of one tool call.",
      "additionalProperties": false,
      "required": [
        "schema_name", "schema_version", "tool_call_id", "run_id", "tool_name", "tool_version",
        "tool_schema_digest", "argument_digest", "requested_effects", "requested_resources",
        "expected_candidate_snapshot", "timeout_ms", "status", "started_at", "finished_at",
        "exit_code", "stdout", "stderr", "artifacts", "pre_candidate_snapshot",
        "post_candidate_snapshot", "error", "digest"
      ],
      "properties": {
        "schema_name": { "const": "ToolCallRecord" },
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "tool_call_id": { "$ref": "semantic_types.schema.json#/$defs/ToolCallId" },
        "run_id": { "$ref": "semantic_types.schema.json#/$defs/RunId" },
        "tool_name": { "type": "string", "minLength": 1 },
        "tool_version": { "type": "integer", "minimum": 1 },
        "tool_schema_digest": { "$ref": "semantic_types.schema.json#/$defs/Digest" },
        "argument_digest": { "$ref": "semantic_types.schema.json#/$defs/Digest" },
        "requested_effects": { "type": "array", "uniqueItems": true, "items": { "$ref": "semantic_types.schema.json#/$defs/Effect" } },
        "requested_resources": { "type": "array", "items": { "$ref": "#/$defs/NormalizedResource" } },
        "expected_candidate_snapshot": { "anyOf": [{ "$ref": "semantic_types.schema.json#/$defs/SnapshotDigest" }, { "type": "null" }] },
        "timeout_ms": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
        "status": {
          "type": "string",
          "enum": ["SUCCESS", "FAILURE", "TIMEOUT", "CANCELLED", "DENIED", "BLOCKED_CAPABILITY", "STALE_PRECONDITION"]
        },
        "started_at": { "$ref": "semantic_types.schema.json#/$defs/UtcTimestamp" },
        "finished_at": { "$ref": "semantic_types.schema.json#/$defs/UtcTimestamp" },
        "exit_code": { "anyOf": [{ "type": "integer" }, { "type": "null" }] },
        "stdout": { "anyOf": [{ "$ref": "semantic_types.schema.json#/$defs/InlineTextOrArtifact" }, { "type": "null" }] },
        "stderr": { "anyOf": [{ "$ref": "semantic_types.schema.json#/$defs/InlineTextOrArtifact" }, { "type": "null" }] },
        "artifacts": { "type": "array", "items": { "$ref": "semantic_types.schema.json#/$defs/ArtifactId" } },
        "pre_candidate_snapshot": { "anyOf": [{ "$ref": "semantic_types.schema.json#/$defs/SnapshotDigest" }, { "type": "null" }] },
        "post_candidate_snapshot": { "anyOf": [{ "$ref": "semantic_types.schema.json#/$defs/SnapshotDigest" }, { "type": "null" }] },
        "error": { "anyOf": [{ "$ref": "#/$defs/ToolError" }, { "type": "null" }] },
        "digest": { "$ref": "semantic_types.schema.json#/$defs/Digest" }
      },
      "$comment": "9.14.2: a tool MUST NOT return SUCCESS if the operation's atomicity guarantee was not met (INV-TOOL-001); enforced by runtime tool code, not expressible as a schema-only constraint."
    },

    "ModelCallRecord": {
      "type": "object",
      "description": "9.6.4. Minimum record for the events model.call.started/completed/failed (9.10.2) and the provider gateway's route/capability model, continuation-state preservation, and retry/model-identity requirements (Phase 4 deliverables in phase-registry.md).",
      "$comment": "Unlike RunRecord/CheckpointRecord/ArtifactRecord/IntegrationRecord, no Blueprint DDL or protocol section gives ModelCallRecord an explicit field list; this is a Phase-0C minimum-viable design grounded only in the event names (9.10.2) and Phase 4's stated deliverables (phase-registry.md), not a literal transcription. It MUST be reconciled (fields added/renamed as needed) when Phase 4's provider gateway contract is closed, and MUST NOT be read as ProviderGateway v1 by anticipation.",
      "additionalProperties": false,
      "required": [
        "schema_name", "schema_version", "model_call_id", "run_id", "route", "provider",
        "model_identity", "request_digest", "status", "started_at", "finished_at",
        "input_tokens", "output_tokens", "continuation_state_digest", "artifacts", "error", "digest"
      ],
      "properties": {
        "schema_name": { "const": "ModelCallRecord" },
        "schema_version": { "$ref": "#/$defs/SchemaVersion" },
        "model_call_id": { "$ref": "semantic_types.schema.json#/$defs/ModelCallId" },
        "run_id": { "$ref": "semantic_types.schema.json#/$defs/RunId" },
        "route": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "model_identity": { "type": "string", "minLength": 1 },
        "request_digest": { "$ref": "semantic_types.schema.json#/$defs/Digest" },
        "status": { "type": "string", "enum": ["SUCCESS", "FAILURE", "TIMEOUT", "CANCELLED"] },
        "started_at": { "$ref": "semantic_types.schema.json#/$defs/UtcTimestamp" },
        "finished_at": { "anyOf": [{ "$ref": "semantic_types.schema.json#/$defs/UtcTimestamp" }, { "type": "null" }] },
        "input_tokens": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
        "output_tokens": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
        "continuation_state_digest": { "anyOf": [{ "$ref": "semantic_types.schema.json#/$defs/Digest" }, { "type": "null" }] },
        "artifacts": { "type": "array", "items": { "$ref": "semantic_types.schema.json#/$defs/ArtifactId" } },
        "error": { "anyOf": [{ "$ref": "#/$defs/ToolError" }, { "type": "null" }] },
        "digest": { "$ref": "semantic_types.schema.json#/$defs/Digest" }
      }
    },

    "SubagentExecutionRecord": {
      "type": "object",
      "description": "9.6.4, 4.6, 10.3.10. Keyed by work_package_id: one WorkPackage dispatch produces exactly one child execution record (child_depth is fixed at 1; recursive subagents prohibited per architecture-boundaries.md).",
      "additionalProperties": false,
      "required": [
        "schema_name", "schema_version", "work_package_id", "work_package_digest", "parent_run_id",
        "child_worktree_identity", "status", "dispatched_at", "completed_at", "result_kind",
        "result_commit", "result_patch_artifact_id", "evidence_artifact_ids", "integrated", "digest"
      ],
      "properties": {
        "schema_name": { "const": "SubagentExecutionRecord" },
