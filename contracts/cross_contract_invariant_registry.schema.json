{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-coding-harness.dev/contracts/cross_contract_invariant_registry.schema.json",
  "x-contract-name": "CrossContractInvariantRegistry",
  "x-contract-version": 1,
  "title": "CrossContractInvariantRegistry v1",
  "description": "Sole registry for the minimum cross-contract invariant set (Unified Implementation Blueprint 9.7). Each invariant has a stable ID, severity, owning contracts, executable test references, and failure disposition. A release MUST fail if any required invariant has no executable test mapping.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "x-contract-name", "x-contract-version", "categories", "invariants"],
  "properties": {
    "$schema": { "const": "https://agentic-coding-harness.dev/contracts/cross_contract_invariant_registry.schema.json" },
    "x-contract-name": { "const": "CrossContractInvariantRegistry" },
    "x-contract-version": { "type": "integer", "minimum": 1 },
    "categories": {
      "description": "9.7's minimum coverage categories.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["IDENTITY", "REVISION", "APPROVAL", "STATE", "ACCEPT", "SECURITY", "RESOURCE", "WORKTREE", "EVENT", "TOOL", "VERIFY", "SECRET", "GOAL"]
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/invariant" }
    }
  },
  "$defs": {
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "required", "severity", "statement", "owning_contracts", "failure_disposition", "test_refs", "enforcement_status"],
      "properties": {
        "id": { "type": "string", "pattern": "^INV-[A-Z]+-[0-9]{3}$" },
        "enforcement_status": {
          "type": "string",
          "enum": ["AWAITING_RUNTIME_INTEGRATION", "RUNTIME_ENFORCED"],
          "description": "Honest current status: whether a live runtime component actually calls this invariant's checker, or only a reference-implementation predicate exists pending the owning runtime phase. Must not be read as 'enforced' until RUNTIME_ENFORCED."
        },
        "category": {
          "type": "string",
          "enum": ["IDENTITY", "REVISION", "APPROVAL", "STATE", "ACCEPT", "SECURITY", "RESOURCE", "WORKTREE", "EVENT", "TOOL", "VERIFY", "SECRET", "GOAL"]
        },
        "required": {
          "type": "boolean",
          "description": "9.7: a release MUST fail if any required invariant has no executable test mapping."
        },
        "severity": { "type": "string", "enum": ["BLOCKING"] },
        "statement": { "type": "string", "minLength": 1 },
        "owning_contracts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "failure_disposition": { "type": "string", "minLength": 1 },
        "test_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^tests/[A-Za-z0-9_./]+\\.py::[A-Za-z0-9_]+$" }
        },
        "checker_ref": {
          "type": "string",
          "minLength": 1,
          "description": "Optional dotted reference to the pure-function reference-implementation checker in src/agentic_harness/_invariants.py, where one exists at this phase."
        }
      }
    }
  }
}
